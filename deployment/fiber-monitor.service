# /etc/systemd/system/fiber-monitor.service
# Monitoring engine fiber-monitor (Go backend)
#
# Install:
#   sudo cp deployment/fiber-monitor.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fiber-monitor

[Unit]
Description=Fiber Monitor - ISP Connection Monitoring Service
Documentation=https://github.com/your-org/fiber-monitor
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/fiber-monitor
ExecStart=/opt/fiber-monitor/fiber-monitor-server
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Environment
EnvironmentFile=/opt/fiber-monitor/.env
Environment=GIN_MODE=release

# Keamanan minimum
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# VPN tunnel & ping memerlukan akses root/net admin:
# ReadWritePaths=/etc/ppp /tmp /run

[Install]
WantedBy=multi-user.target