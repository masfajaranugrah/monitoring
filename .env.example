# =======================================================
#  Monitoring - Environment Configuration
#  Salin ke .env lalu sesuaikan nilainya.
#  cp .env.example .env
# =======================================================

# --- Server ---
SERVER_PORT=8080
GIN_MODE=release

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgres://monitor:monitor123@localhost:5432/monitoring?sslmode=disable

# --- Autentikasi ---
# WAJIB diganti di production. Minimal 32 karakter acak.
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRY_HOURS=24

# Kunci enkripsi password VPN (AES-256-GCM).
# Nilai apa pun yang panjang acak akan di-hash SHA-256 menjadi kunci 32 byte.
# Generate: openssl rand -base64 48
ENCRYPTION_KEY=

# Kredensial admin pertama (dibuat saat pertama kali aplikasi dijalankan)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin123

# --- Monitoring Engine ---
# Jumlah worker ping paralel (default 30)
PING_CONCURRENCY=30
# Retensi riwayat ping dalam hari (default 7)
PING_HISTORY_RETENTION_DAYS=7

# --- Modem Management API (ZTE ZXHN F663NV9 dkk) ---
# Kredensial default yang dipakai bila pelanggan tidak punya kredensial modem
# sendiri di database. Bisa di-override per pelanggan lewat API customer
# (modem_web_user / modem_web_pass / modem_telnet_user / modem_telnet_pass).
MODEM_WEB_USER=admin
MODEM_WEB_PASS=admin
MODEM_WEB_PORT=80
MODEM_WEB_HTTPS=false
# Telnet perangkat ZTE (default user root, password Zte521 setelah diaktifkan).
MODEM_TELNET_USER=root
MODEM_TELNET_PASS=
MODEM_TELNET_PORT=23

# --- Google Maps (OPSIONAL) ---
# Peta default memakai Leaflet + OpenStreetMap (tanpa API key).
# Isi ini hanya jika memakai varian peta Google Maps (MapView.google.vue).
# VITE_GOOGLE_MAPS_API_KEY=